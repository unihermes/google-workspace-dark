{
  "manifest_version": 3,
  "name": "Workspace Dark",
  "version": "1.0.0",
  "description": "Dark mode for Google Drive, Docs, Slides and Sheets — keeps Docs pages and Slides canvases white for readability.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://drive.google.com/*",
    "https://docs.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*",
        "https://docs.google.com/document/*",
        "https://docs.google.com/presentation/*",
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": ["content.js"],
      "css": ["dark.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Workspace Dark",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "workspace-dark@extension",
      "strict_min_version": "128.0"
    }
  }
}
